# Required for AI diagnosis and spoken voice replies
GEMINI_API_KEY=your_google_ai_studio_api_key
# Optional model overrides (legacy Gemini 2.5 Flash values are upgraded in code)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Supabase Auth and cloud farmer profiles
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Fallback climate location (Coimbatore, Tamil Nadu)
DEFAULT_LATITUDE=11.0168
DEFAULT_LONGITUDE=76.9558
PORT=5000
